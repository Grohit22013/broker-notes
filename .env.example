# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Database (Neon Postgres) ---
# Pooled connection string (host contains "-pooler"), used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-2.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooled) connection string, used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-2.aws.neon.tech/neondb?sslmode=require"

# --- Auth (Phase 1) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# --- AI via OpenRouter (Phase 5) ---
OPENROUTER_API_KEY=""
# Any OpenRouter model id; ":free" models cost nothing.
OPENROUTER_MODEL=""
