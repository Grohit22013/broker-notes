# BrokerNotes API — copy to apps/api/.env and fill in. Never commit .env.

# --- Database (Neon Postgres) ---
# Pooled connection string (host contains "-pooler"), used by the API at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-2.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooled) connection string, used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-2.aws.neon.tech/neondb?sslmode=require"

# --- Sessions ---
# Signs session JWTs. Must be the SAME value as apps/web/.env AUTH_SECRET.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# --- Server ---
PORT=4000
# Browser origin allowed by CORS (the web app normally proxies /api so this rarely matters).
WEB_ORIGIN="http://localhost:3000"
# Optional: login/register attempts per IP per minute (default 10).
# AUTH_RATE_LIMIT=10
# Optional: force secure cookies on/off (defaults to on in production).
# COOKIE_SECURE=false

# --- AI via OpenRouter (Phase 6) — free ":free" models only ---
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""
