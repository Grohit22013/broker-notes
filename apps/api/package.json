{
  "name": "@broker-notes/api",
  "version": "0.1.0",
  "private": true,
  "description": "BrokerNotes REST API (NestJS). Owns auth, notes, clients, CSV and all database access.",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:int": "jest --config jest.int.config.js --runInBand",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@broker-notes/shared": "*",
    "@nestjs/common": "11.2.10",
    "@nestjs/core": "11.2.10",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.10",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.7.1",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.10",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "jest": "30.5.2",
    "prisma": "^6.19.3",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15"
  }
}
