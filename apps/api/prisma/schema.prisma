// Prisma schema for BrokerNotes.
// Models are added phase by phase (User in Phase 1, Note in Phase 2, Client in Phase 4,
// Organisation / roles / audit log in Phase 8).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Neon "-pooler" host): used by the app at runtime.
  url       = env("DATABASE_URL")
  // Direct connection: used by Prisma Migrate.
  directUrl = env("DIRECT_URL")
}

/// A brokerage. Every client, note, invite and audit entry belongs to exactly one organisation,
/// and the API scopes every query by it (multi-tenancy).
model Organisation {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   User[]
  clients   Client[]
  notes     Note[]
  cases     MortgageCase[]
  tasks     Task[]
  invites   Invite[]
  auditLogs AuditLog[]
}

/// What a member may do inside their organisation (see packages/shared/src/orgs/permissions.ts).
enum Role {
  ADMIN
  ADVISER
  CASE_MANAGER
}

/// A member of a brokerage. Users are deactivated, never deleted, so authorship stays intact.
model User {
  id             String       @id @default(cuid())
  name           String
  /// Always stored lower-cased and trimmed.
  email          String       @unique
  /// bcrypt hash — the plain password is never stored.
  passwordHash   String
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  role           Role         @default(ADVISER)
  /// Set when an admin deactivates the member: they can no longer sign in or use the API.
  deactivatedAt  DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  notes           Note[]
  clients         Client[]       @relation("ClientCreatedBy")
  assignedClients Client[]       @relation("ClientAdviser")
  casesCreated    MortgageCase[] @relation("CaseCreatedBy")
  assignedCases   MortgageCase[] @relation("CaseAdviser")
  tasksCreated    Task[]         @relation("TaskCreatedBy")
  assignedTasks   Task[]         @relation("TaskAssignee")
  tasksCompleted  Task[]         @relation("TaskCompletedBy")
  aiUsages        AiUsage[]
  invitesSent     Invite[]
  auditLogs       AuditLog[]

  @@index([organisationId])
}

/// A single-use, expiring invitation to join an organisation. Only a hash of the token is stored.
model Invite {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  /// The invitee must register with exactly this (lower-cased) email.
  email          String
  role           Role
  /// SHA-256 of the token in the invite link.
  tokenHash      String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  invitedById    String
  invitedBy      User         @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organisationId, createdAt(sort: Desc)])
}

/// Append-only record of important actions (who did what, when) — admins can review it.
model AuditLog {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  /// Who did it (null if that user record is ever removed).
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Dotted action name, e.g. "note.finalised", "member.role_changed".
  action         String
  entityType     String?
  entityId       String?
  /// Human-readable one-liner shown in the log ("Finalised “Fact find — Nguyen family”").
  summary        String
  /// Small structured details (changed fields, old/new role, counts). Never note content.
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organisationId, createdAt(sort: Desc)])
  @@index([organisationId, action])
}

/// One row per AI request — used for the per-broker daily limit and basic auditing.
model AiUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteId    String?
  model     String
  ok        Boolean
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// A brokerage's client (borrower / household). Notes can be linked to one client.
model Client {
  id                String       @id @default(cuid())
  organisationId    String
  organisation      Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  /// Who created the record.
  userId            String
  user              User         @relation("ClientCreatedBy", fields: [userId], references: [id], onDelete: Cascade)
  /// The adviser looking after this client (optional).
  assignedAdviserId String?
  assignedAdviser   User?        @relation("ClientAdviser", fields: [assignedAdviserId], references: [id], onDelete: SetNull)
  name              String
  /// Stored lower-cased; unique per organisation when present (used to de-duplicate CSV imports).
  email             String?
  phone             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  notes Note[]
  cases MortgageCase[]
  tasks Task[]

  @@unique([organisationId, email])
  @@index([organisationId, name])
}

/// A file note. Rich text is stored as Tiptap JSON; plain text is kept for search/snippets.
model Note {
  id             String        @id @default(cuid())
  organisationId String
  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  /// The author. Only the author or an organisation admin may change the note.
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String        @default("")
  /// Tiptap/ProseMirror document JSON.
  contentJson    Json
  /// Plain-text projection of contentJson (search + list snippets).
  contentText    String        @default("")
  /// What kind of file note this is (drives templates and filtering).
  noteType       NoteType      @default(GENERAL)
  /// Where the client's loan is in the pipeline when this note was written (optional).
  loanStage      LoanStage?
  /// Free-form labels, e.g. "first-home-buyer", "refinance". De-duplicated case-insensitively.
  tags           String[]      @default([])
  /// When the broker needs to follow up (call back, chase documents, review).
  followUpAt     DateTime?
  pinned         Boolean       @default(false)
  /// The mortgage case this note belongs to (its client is then the case's client).
  caseId         String?
  case           MortgageCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  clientId       String?
  client         Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// Key loan figures (loan amount, property value, income, rate, lender) — validated by Zod.
  keyFigures     Json?
  /// DRAFT notes are editable; FINALISED notes are locked and only accept amendments.
  status         NoteStatus    @default(DRAFT)
  finalisedAt    DateTime?
  /// Latest AI analysis (draft suggestions — never applied without the broker's click).
  aiAnalysis     Json?
  /// SHA-256 of what was analysed, so an unchanged note reuses the cached result.
  aiInputHash    String?
  aiAnalysedAt   DateTime?
  aiModel        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  /// Soft delete — file notes are compliance records, so we never hard-delete.
  deletedAt      DateTime?

  versions   NoteVersion[]
  amendments NoteAmendment[]
  tasks      Task[]

  @@index([organisationId, deletedAt, updatedAt(sort: Desc)])
  @@index([organisationId, followUpAt])
  @@index([userId])
  @@index([clientId])
  @@index([caseId])
}

enum NoteStatus {
  DRAFT
  FINALISED
}

/// Append-only addition to a finalised note (RG 273: records are amended, never silently rewritten).
model NoteAmendment {
  id        String   @id @default(cuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([noteId, createdAt])
}

enum NoteType {
  DISCOVERY
  FACT_FIND
  LENDER_RATIONALE
  CONDITIONS
  SETTLEMENT
  REVIEW
  GENERAL
}

/// Simplified Australian home-loan pipeline.
enum LoanStage {
  LEAD
  PRE_APPROVAL
  APPLICATION
  CONDITIONAL
  UNCONDITIONAL
  SETTLED
  REVIEW
}

/// Append-only snapshot of a note, for the audit trail / version history.
model NoteVersion {
  id          String   @id @default(cuid())
  noteId      String
  note        Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  title       String
  contentJson Json
  createdAt   DateTime @default(now())

  @@index([noteId, createdAt(sort: Desc)])
}

/// The nine-stage mortgage pipeline (research doc §6.5), in Australian terms.
enum CaseStage {
  ENQUIRY
  FACT_FIND
  RESEARCH
  RECOMMENDATION
  LODGED
  ASSESSMENT
  APPROVED
  SETTLED
  CLOSED
}

enum CaseType {
  FIRST_HOME
  PURCHASE
  REFINANCE
  INVESTMENT
  TOP_UP
  CONSTRUCTION
  PRODUCT_SWITCH
}

/// One client's loan deal moving through the pipeline. Notes can be linked to a case.
model MortgageCase {
  id                String       @id @default(cuid())
  organisationId    String
  organisation      Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  clientId          String
  client            Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// "HL-2026-0007": unique per brokerage, assigned on creation.
  reference         String
  type              CaseType
  stage             CaseStage    @default(ENQUIRY)
  stageChangedAt    DateTime     @default(now())
  lender            String?
  /// The lender's own application number.
  lenderReference   String?
  /// Whole Australian dollars.
  loanAmount        Int?
  propertyValue     Int?
  assignedAdviserId String?
  assignedAdviser   User?        @relation("CaseAdviser", fields: [assignedAdviserId], references: [id], onDelete: SetNull)
  createdById       String
  createdBy         User         @relation("CaseCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  notes Note[]
  tasks Task[]

  @@unique([organisationId, reference])
  @@index([organisationId, stage])
  @@index([clientId])
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

/// A follow-up action (research doc §6.7), optionally tied to a note, client and/or case.
/// Never deleted: tasks are completed or cancelled, and every change is audited.
model Task {
  id             String        @id @default(cuid())
  organisationId String
  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  status         TaskStatus    @default(PENDING)
  priority       TaskPriority  @default(MEDIUM)
  /// Midnight (Australia/Sydney) of the due day.
  dueAt          DateTime?
  noteId         String?
  note           Note?         @relation(fields: [noteId], references: [id], onDelete: SetNull)
  clientId       String?
  client         Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  caseId         String?
  case           MortgageCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  assigneeId     String?
  assignee       User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById    String
  createdBy      User          @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  completedAt    DateTime?
  completedById  String?
  completedBy    User?         @relation("TaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organisationId, status, dueAt])
  @@index([assigneeId, status])
  @@index([noteId])
  @@index([clientId])
  @@index([caseId])
}
