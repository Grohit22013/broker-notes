# BrokerNotes web app — copy to apps/web/.env. Never commit .env.

# Where the NestJS API runs. The web app proxies browser calls from /api/* to it
# (resolved at build time — rebuild after changing) and calls it directly when rendering.
API_URL="http://localhost:4000"

# Must be the SAME value as apps/api/.env AUTH_SECRET (the middleware verifies session JWTs).
AUTH_SECRET=""
