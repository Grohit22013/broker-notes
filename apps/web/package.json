{
  "name": "@broker-notes/web",
  "version": "0.1.0",
  "private": true,
  "description": "BrokerNotes frontend (Next.js). Renders the UI and calls the NestJS API — no database access.",
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@broker-notes/shared": "*",
    "@tiptap/extension-highlight": "3.35.0",
    "@tiptap/extension-list": "3.35.0",
    "@tiptap/extension-table": "3.35.0",
    "@tiptap/extensions": "3.35.0",
    "@tiptap/pm": "3.35.0",
    "@tiptap/react": "3.35.0",
    "@tiptap/starter-kit": "3.35.0",
    "@tiptap/suggestion": "3.35.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "jose": "6.2.17",
    "lucide-react": "^1.82.0",
    "next": "15.5.29",
    "next-themes": "^0.4.6",
    "papaparse": "5.7.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@prisma/client": "^6.19.3",
