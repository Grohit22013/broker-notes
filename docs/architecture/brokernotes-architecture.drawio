  <diagram name="06 · AI Judgment Core" id="page6">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1169" pageHeight="728" math="0" shadow="0">
