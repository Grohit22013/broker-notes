        <mxCell id="t2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#475E75;" value="L2 · one structured request per analysis — deterministic prep, a free model, strict validation, cached result" vertex="1"><mxGeometry x="30" y="58" width="1109" height="20" as="geometry" /></mxCell>
        <mxCell id="g3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#1D2D3E;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10;strokeColor=#188918;fillColor=#F5FAE5;" value="Deterministic prep (API)" vertex="1"><mxGeometry x="40" y="100" width="330" height="470" as="geometry" /></mxCell>
        <mxCell id="b4" parent="g3" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=10;strokeWidth=1.3;fontFamily=Helvetica;fontColor=#1D2D3E;fontSize=11;align=center;verticalAlign=middle;spacing=6;strokeColor=#188918;fillColor=#FFFFFF;" value="Build the input: title, note type, loan stage, structured text ([ ] / [x] checklists), Today (Sydney), already-scheduled dates" vertex="1"><mxGeometry x="12" y="45" width="306" height="90" as="geometry" /></mxCell>
        <mxCell id="b5" parent="g3" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=10;strokeWidth=1.3;fontFamily=Helvetica;fontColor=#1D2D3E;fontSize=11;align=center;verticalAlign=middle;spacing=6;strokeColor=#188918;fillColor=#FFFFFF;" value="Redact TFN, Medicare, card, phone and email numbers before anything leaves the server" vertex="1"><mxGeometry x="12" y="145" width="306" height="90" as="geometry" /></mxCell>
        <mxCell id="b6" parent="g3" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=10;strokeWidth=1.3;fontFamily=Helvetica;fontColor=#1D2D3E;fontSize=11;align=center;verticalAlign=middle;spacing=6;strokeColor=#188918;fillColor=#FFFFFF;" value="Truncate to 12,000 characters · cache check: same input hash → return the saved result, no request" vertex="1"><mxGeometry x="12" y="245" width="306" height="90" as="geometry" /></mxCell>
        <mxCell id="b7" parent="g3" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=10;strokeWidth=1.3;fontFamily=Helvetica;fontColor=#1D2D3E;fontSize=11;align=center;verticalAlign=middle;spacing=6;strokeColor=#188918;fillColor=#FFFFFF;" value="Quota: 20 analyses per broker per day (Sydney midnight reset), counted in AiUsage" vertex="1"><mxGeometry x="12" y="345" width="306" height="110" as="geometry" /></mxCell>
        <mxCell id="g8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#1D2D3E;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10;strokeColor=#5D36FF;fillColor=#F1ECFF;" value="AI call (OpenRouter, :free only)" vertex="1"><mxGeometry x="410" y="100" width="330" height="470" as="geometry" /></mxCell>
