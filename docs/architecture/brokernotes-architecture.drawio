        <mxCell id="b3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=10;strokeWidth=1.3;fontFamily=Helvetica;fontColor=#1D2D3E;fontSize=12;align=center;verticalAlign=middle;spacing=6;strokeColor=#0070F2;fillColor=#FFFFFF;" value="1 · New note — pick the client (or + Add client inline) and a template" vertex="1"><mxGeometry x="40" y="130" width="200" height="150" as="geometry" /></mxCell>
        <mxCell id="b4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=10;strokeWidth=1.3;fontFamily=Helvetica;fontColor=#1D2D3E;fontSize=12;align=center;verticalAlign=middle;spacing=6;strokeColor=#188918;fillColor=#FFFFFF;" value="2 · Note created as DRAFT; a Client meeting note starts with the meeting time set" vertex="1"><mxGeometry x="262" y="130" width="200" height="150" as="geometry" /></mxCell>
