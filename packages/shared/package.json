{
  "name": "@broker-notes/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Zod schemas, API types and pure business logic shared by the BrokerNotes web app and API.",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/esm/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.esm.json",
    "dev": "concurrently -k -n cjs,esm \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"tsc -p tsconfig.esm.json --watch --preserveWatchOutput\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "sideEffects": false
}
